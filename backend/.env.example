# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HabitFlow Pro – Environment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Copy this file to .env and fill in actual values.
# NEVER commit the real .env file.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Application ────────────────────────────────────────
HF_APP_NAME=HabitFlow Pro
HF_APP_VERSION=1.0.0
HF_DEBUG=true
HF_ENVIRONMENT=development

# ── Server ─────────────────────────────────────────────
HF_HOST=127.0.0.1
HF_PORT=8000
HF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ── Database ───────────────────────────────────────────
HF_DATABASE_URL=sqlite:///./habitflow.db

# ── JWT Secrets (generate with: openssl rand -hex 64) ──
HF_JWT_SECRET_KEY=CHANGE_ME_generate_a_64_char_hex_string
HF_JWT_ALGORITHM=HS256
HF_ACCESS_TOKEN_EXPIRE_MINUTES=15
HF_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Security ──────────────────────────────────────────
HF_RATE_LIMIT_PER_MINUTE=60
HF_ARGON2_TIME_COST=2
HF_ARGON2_MEMORY_COST=102400
HF_ARGON2_PARALLELISM=8

# ── Logging ───────────────────────────────────────────
HF_LOG_LEVEL=INFO
HF_LOG_FORMAT=json
